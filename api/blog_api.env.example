# ------------------------------------------------------------
# Blog REST API — variabili da aggiungere al file .env (FUORI webroot).
# Lette da api/blog.php via getenv(). NON committare valori reali.
# ------------------------------------------------------------

# Chiave dell'API blog. Finche' e' vuota/assente, l'API risponde 503 (disattivata):
# nessun accesso aperto. Genera una chiave lunga e casuale, es.:
#   php -r "echo bin2hex(random_bytes(32));"
BLOG_API_KEY=

# (Opzionale) id_user usato come autore per i post creati via API (ChatGPT).
# Se assente, l'API usa il primo utente con ruolo admin/expert.
BLOG_API_AUTHOR_ID=

# Nota: la pubblicazione programmata (status=scheduled) viene attivata dal cron
#   cron/blog_publish_scheduled.php  (protetto dal CRON_TOKEN gia' presente in .env).
